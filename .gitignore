# Лицензия конкретной установки (привязана к этому компьютеру) и реестр
# выданных лицензий — это данные, а не код: в репозитории им не место.
fountain.license.json
packages/engine/license-keys/issued-licenses.json

# Артефакты сборки настольного приложения (packages/app)
packages/app/engine.cjs
packages/app/ui/
packages/app/release/

# Лицензирование: приватный ключ издателя лицензий в репозиторий не кладём
# никогда. Кто им владеет — тот может выпускать лицензии на продукт, поэтому
# ключ переносится между машинами вручную, мимо git: на машине, где выпускают
# лицензии, он лежит в packages/engine/license-keys/private.pem, на остальных
# его просто нет, и выдача там недоступна.
packages/engine/license-keys/

# Лицензия конкретной установки (привязана к компьютеру) — это данные.
fountain.license.json
