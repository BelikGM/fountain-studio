node_modules/
dist/
build/
.vite/
*.log
.DS_Store
Thumbs.db
*.local

# Секреты объекта: токен телеграм-бота и прочие пароли. В репозиторий не кладём
# никогда — файл живёт только на машине объекта.
fountain.secrets.json
telegram-queue.json

# Данные проекта фонтана (создаются движком в рабочей папке)
fountain.project.json
fountain.project.json.broken
audio/
backups/
logs/

# Оформление установщика и значок программы — исходники сборки, а не её
# результат: их читает electron-builder (buildResources). Правило «build/»
# выше их прятало. Пересобираются scripts/make-brand-assets.cjs.
!packages/app/build/

# Артефакты сборки настольного приложения (packages/app)
packages/app/engine.cjs
packages/app/playback-worker.cjs
packages/app/ui/
packages/app/release/

# Лицензирование: приватный ключ издателя лицензий в репозиторий не кладём
# никогда. Кто им владеет — тот может выпускать лицензии на продукт, поэтому
# ключ переносится между машинами вручную, мимо git: на машине, где выпускают
# лицензии, он лежит в packages/engine/license-keys/private.pem, на остальных
# его просто нет, и выдача там недоступна. Вся папка целиком — журнал выданных,
# имена компьютеров и список отозванных тоже данные продавца, не код.
packages/engine/license-keys/

# Лицензия конкретной установки (привязана к компьютеру) — тоже данные, а не
# код, и в чужих руках это чей-то реальный доступ. issue-license.ts по
# умолчанию называет файл «license-<покупатель>.json» — ловим и это имя, и
# то, что вручную назвали при --out (my-license.json — так делали при
# самопроверке 17.09.2026, файл уже лежал в корне репозитория).
fountain.license.json
license-*.json
my-license.json
